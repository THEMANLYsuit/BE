# THE MANLY 맞춤정장 API — 환경변수 (이 파일을 .env 로 복사해서 채운다. .env 는 커밋하지 않는다)
#
# 로컬은 전부 비워 둬도 돈다 (application.yml local 프로필의 개발값). 운영은 아래를 전부 채운다.

# ── 데이터베이스 (운영 필수) ───────────────────────────────
DB_NAME=themanly
DB_USERNAME=themanly
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ── 주소 ──────────────────────────────────────────────────
# 손님 화면 주소 — CORS 허용 · 메일 속 링크. 로컬 3001.
# CORS_ALLOWED_ORIGINS=https://themanly.kr
# FRONT_BASE_URL=https://themanly.kr

# ── 메일 (비우면 보내지 않고 경고만 남긴다) ─────────────────
# SPRING_MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=THE MANLY <no-reply@themanly.kr>
# 새 예약 · 취소 알림을 받을 관리자 메일(쉼표로 여럿)
# BOOKING_NOTIFY_EMAILS=

# ── 예약 규칙 (application.yml 기본값: 10~20시 · 60분 · 화수 휴무 · 24시간 뒤부터 60일 앞까지) ──
# BOOKING_OPEN_HOUR=10
# BOOKING_CLOSE_HOUR=20
# BOOKING_SLOT_MINUTES=60
# BOOKING_CLOSED_DAYS=TUESDAY,WEDNESDAY
# BOOKING_MIN_LEAD_HOURS=24
# BOOKING_MAX_AHEAD_DAYS=60
